rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(resourceData) {
      return signedIn() && resourceData.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;

      match /preferences/{preferenceId} {
        allow read, create, update, delete: if signedIn()
          && request.auth.uid == userId
          && preferenceId == "default";
      }
    }

    match /{collection}/{documentId} {
      allow read: if owns(resource.data);
      allow create: if owns(request.resource.data);
      allow update: if owns(resource.data)
        && owns(request.resource.data)
        && request.resource.data.userId == resource.data.userId;
      allow delete: if owns(resource.data);
    }
  }
}
